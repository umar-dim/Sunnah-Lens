# PostgreSQL connection string (use Supabase Transaction mode for asyncpg)
DATABASE_URL=postgresql://user:password@host:6543/postgres

# Google Gemini API key for generating embeddings
GEMINI_API_KEY=your_gemini_api_key_here

# AI chat (/api/chat): any OpenAI-compatible endpoint, separate from the embedding key.
# Leave unset to disable chat (the endpoint returns 503; search keeps working).
CHAT_BASE_URL=https://api.openai.com/v1
CHAT_API_KEY=
CHAT_MODEL=gpt-4o-mini
